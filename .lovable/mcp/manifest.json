{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "elite-jewellery-gallery-mcp",
      "version": "0.1.0",
      "title": "Elite Jewellery Gallery MCP"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "List jewellery categories",
        "description": "List all product categories available at Elite Jewellery Gallery.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List products from the Elite Jewellery Gallery catalog. Optionally filter by category or new arrivals, and limit results.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Filter by category",
              "type": "string",
              "enum": [
                "Rings",
                "Necklaces",
                "Earrings",
                "Bracelets",
                "Bangles",
                "Anklets"
              ]
            },
            "onlyNew": {
              "description": "Only return new arrivals",
              "type": "boolean"
            },
            "limit": {
              "description": "Max products to return (default 20)",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product details",
        "description": "Get full details for a single product by its id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The product id, e.g. 'ank1' or 'new2'"
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Full-text search across product names, descriptions, categories, and metals. Returns matching products.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Keywords to search for"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "request_quote_link",
        "title": "Get WhatsApp quote link",
        "description": "Generate a WhatsApp deep-link with a pre-filled quote request for a product id. Omit id for a general enquiry link.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "description": "Product id to request a quote for",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "store_info",
        "title": "Store contact info",
        "description": "Get store name, address, phone, WhatsApp, and email for Elite Jewellery Gallery.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
